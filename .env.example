# Start with npm start from the repository folder.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/workforce.sqlite

# Set the office's public origin when HTTPS is ready.
# PUBLIC_ORIGIN=https://workspace.example.org
# TRUST_PROXY_IP=127.0.0.1

# Use both TLS paths for direct Node HTTPS, or terminate HTTPS at a local proxy.
# TLS_KEY_PATH=C:/ConceptPrivate/tls/privkey.pem
# TLS_CERT_PATH=C:/ConceptPrivate/tls/fullchain.pem

# Closed-app Web Push is optional and uses browser-operated infrastructure.
ENABLE_WEB_PUSH=0
# WEB_PUSH_CONTACT=mailto:workspace@example.org

# Keep backups on a separate authorized drive where available.
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=30
